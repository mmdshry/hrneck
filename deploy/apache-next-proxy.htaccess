# Document root for hrneck.com / tenant hosts → reverse-proxy to Next + Reverb.
# Requires: mod_rewrite, mod_proxy, mod_proxy_http, mod_proxy_wstunnel, mod_headers

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Laravel Reverb WebSocket (Echo uses /app)
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^app(?:/.*)?$ ws://127.0.0.1:8080%{REQUEST_URI} [P,L]
  RewriteRule ^app(?:/.*)?$ http://127.0.0.1:8080%{REQUEST_URI} [P,L]

  # Next.js WebSocket / HTTP
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^(.*)$ ws://127.0.0.1:3100/$1 [P,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ http://127.0.0.1:3100/$1 [P,L]
</IfModule>

<IfModule mod_proxy.c>
  ProxyPreserveHost On
</IfModule>

<IfModule mod_headers.c>
  RequestHeader set X-Forwarded-Proto "https" env=HTTPS
</IfModule>
