APP_NAME="HRNECK Training Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
TELESCOPE_ENABLED=false
# Laravel API/admin host (not the Next frontend). Caddy maps api/admin → :8000.
APP_URL=http://api.hrneck.test
ASSET_URL=http://api.hrneck.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BRAND_NAME="HRNECK Training Portal"
BRAND_SHORT=HRNECK
BRAND_DOMAIN=hrneck.test
TENANCY_BASE_DOMAIN=hrneck.test

DEMO_ADMIN_EMAIL=admin@hrneck.test
DEMO_ADMIN_PASSWORD="DemoPass!234"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrneck_central
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Host-only by default. For shared cookie across {slug}.hrneck.test use .hrneck.test
# (and .hrneck.com in production). Keep aligned with Sanctum stateful domains.
SESSION_DOMAIN=null
# false for local HTTP (*.hrneck.test via Caddy). Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false

# Local/staging may append tunnel hosts via config/sanctum.php when APP_ENV=local|staging.
# Production also appends hrneck.com / *.hrneck.com in config/sanctum.php.
# Production example override:
# SANCTUM_STATEFUL_DOMAINS=hrneck.com,www.hrneck.com,app.hrneck.com,admin.hrneck.com
SANCTUM_STATEFUL_DOMAINS=hrneck.test,app.hrneck.test,admin.hrneck.test,itneck.hrneck.test,test.hrneck.test,company.hrneck.test,localhost,localhost:3100,127.0.0.1:3100

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
CACHE_PREFIX=hrneck_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.hrneck.com
MAIL_PORT=465
MAIL_USERNAME=noreply@hrneck.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@hrneck.com
MAIL_FROM_NAME="${BRAND_SHORT}"
MAIL_SUPPORT_ADDRESS=support@hrneck.com
# Production web: https://hrneck.com (app/admin/{slug} subdomains as needed)
HRNECK_SMTP_SMOKE=0
FRONTEND_URL=http://hrneck.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${BRAND_SHORT}"

REVERB_APP_ID=hrneck
REVERB_APP_KEY=hrneck-reverb-key
REVERB_APP_SECRET=hrneck-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
